{
    "name": "comitidn/project-routeros",
    "description": "Full-Version Lightweight PHP Framework & API for MikroTik RouterOS with Manual, SQL Database & JSON Support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bang AL",
            "email": "acm2lp2@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "comitidn/routeros-api": "*@dev",
        "evilfreelancer/routeros-api-php": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "RouterOSFramework\\": "src/",
            "RouterOSAPI\\": "src/Core/",
            "App\\": "./"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RouterOSFramework\\Integrations\\Laravel\\RouterOSServiceProvider"
            ],
            "aliases": {
                "RouterOS": "RouterOSFramework\\Integrations\\Laravel\\Facades\\RouterOS"
            }
        }
    }
}
